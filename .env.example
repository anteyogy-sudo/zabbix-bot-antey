# --- Zabbix API ---
ZABBIX_URL=http://zabbix.example.com/api_jsonrpc.php
ZABBIX_API_TOKEN=

# --- Фильтрация проблем ---
# Минимальная важность (0..5): Not classified / Information / Warning / Average / High / Disaster
ZABBIX_MIN_SEVERITY=2
# Технические имена хостов через запятую. Пусто = все хосты, доступные пользователю токена.
ZABBIX_HOSTS=

# --- Цикл ---
CHECK_INTERVAL=60
# Хранение состояния отправленных уведомлений
STATE_DB_PATH=state.db
# Повторять уведомление о незакрытой проблеме, сек (0 = не повторять)
RENOTIFY_AFTER=3600
# Считать проблему исчезнувшей (recovery) только если её не было N циклов подряд
RECOVERY_CONFIRM_CYCLES=2
# Авточистка: удалять записи о recovery старше N секунд
STATE_RETENTION=86400
# Через сколько циклов недоступности API бот сам сообщит о слепоте
ZABBIX_ALERT_AFTER_CYCLES=3


SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=zabbix-bot@example.com
EMAIL_RECIPIENTS=admin@example.com
SMTP_TIMEOUT=15


HEARTBEAT_URL=
HTTP_TIMEOUT=15
LOG_LEVEL=INFO
